DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
# Initial admin password: used by first Production build or admin:bootstrap.
# At least 12 characters, maximum 72 UTF-8 bytes. Remove after first successful setup.
ADMIN_BOOTSTRAP_PASSWORD=
# Random 32+ characters; used to pseudonymize rate-limit keys.
AUTH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional one-time password reset for an existing admin. Change this ID only
# when deliberately requesting another reset; remove after success.
ADMIN_PASSWORD_RESET_ID=
